# Groq (LLM for the agent's reasoning / tool-calling)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Pinecone (vector store)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=schedule-agent
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Pinecone hosted embedding model — no local GPU/torch required.
# If you change this, delete and recreate the Pinecone index.
PINECONE_EMBEDDING_MODEL=multilingual-e5-large

# CORS — comma-separated list of allowed origins.
# Defaults to "*" (all origins) if not set. Restrict in production.
# Example: CORS_ORIGINS=https://your-frontend.com,https://other-frontend.com
# CORS_ORIGINS=*
